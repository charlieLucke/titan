# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Qdrant
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
COLLECTION_NAME=mein_wissen

# Hardware
MAX_WORKERS=12
EMBED_BATCH_SIZE=32
LATE_CHUNK_WINDOW_TOKENS=7800

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi4:latest
OLLAMA_TIMEOUT=120

# Epic 4 Evaluation
JUDGE_MODEL=phi4:latest
JUDGE_TIMEOUT=60

# Epic 5B Semantic Caching
CACHE_ENABLED=true
CACHE_COLLECTION_NAME=query_cache
CACHE_THRESHOLD=0.95
CACHE_TTL_SECONDS=604800
CACHE_TOP_K=1

# System
GPU_LOCK_PATH=/tmp/bge_m3.lock
INGEST_BASE_DIR=/mnt/f/data/titan-input

# Service security: only paths under VAULT_ROOT are accepted by /ingest/file,
# /find_related and DELETE /chunks. Must match the actual vault location.
VAULT_ROOT=/mnt/f/vault
